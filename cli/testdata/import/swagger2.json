{
  "swagger": "2.0",
  "info": { "title": "Legacy Inventory", "version": "1.0" },
  "host": "inventory.legacy.test",
  "basePath": "/v2",
  "schemes": ["https"],
  "paths": {
    "/items/{sku}": {
      "get": {
        "tags": ["items"],
        "operationId": "getItem",
        "summary": "Get item",
        "parameters": [
          { "name": "sku", "in": "path", "required": true, "type": "string", "x-example": "SKU-1" }
        ],
        "responses": { "200": { "description": "OK" } }
      }
    },
    "/items": {
      "post": {
        "tags": ["items"],
        "operationId": "createItem",
        "summary": "Create item",
        "consumes": ["application/json"],
        "parameters": [
          {
            "name": "body",
            "in": "body",
            "required": true,
            "schema": {
              "type": "object",
              "properties": {
                "sku": { "type": "string", "example": "SKU-2" },
                "qty": { "type": "integer" }
              }
            }
          }
        ],
        "responses": { "201": { "description": "Created" } }
      }
    }
  }
}
