# Kest API Backend - Environment Variables Template
# Copy this file to .env and fill in your actual values

# ===========================================
# Server Configuration
# ===========================================
PORT=8080
GIN_MODE=debug

# ===========================================
# Database Configuration
# ===========================================
DB_HOST=localhost
DB_PORT=5432
DB_NAME=kest
DB_USER=kest_user
DB_PASSWORD=your-secure-password-here

# ===========================================
# JWT Configuration
# ===========================================
JWT_SECRET=generate-a-random-jwt-secret-here
JWT_EXPIRATION=24h

# ===========================================
# CORS Configuration
# ===========================================
# Explicit, comma-separated list of browser origins allowed to call the API.
# '*' is accepted but disables credentials and logs a warning (a loud one in
# production). ALLOWED_ORIGINS is still read as a legacy fallback.
CORS_ALLOW_ORIGINS=http://localhost:3000,https://kest.example.com
CORS_ALLOW_CREDENTIALS=true

# ===========================================
# Request Runner (outbound requests to user-supplied URLs)
# ===========================================
# Whether request/flow/test runs may reach loopback, private (RFC 1918),
# link-local (incl. 169.254.169.254) and other internal addresses.
# Default: true in local development (APP_ENV=development/local/test and
# GIN_MODE not release), false otherwise. Uncomment to override.
# RUNNER_ALLOW_PRIVATE_NETWORKS=true
# RUNNER_MAX_REDIRECTS=10
# Max response body captured per run, in MB (larger bodies are truncated).
# RUNNER_MAX_RESPONSE_MB=10
